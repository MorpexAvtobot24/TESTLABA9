        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 404 Not Found\", function () {\r\n    pm.response.to.have.status(404);\r\n});\r\n\r\npm.test(\"Error code is NOT_FOUND\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.code).to.eql(\"NOT_FOUND\");\r\n});"
            ]
