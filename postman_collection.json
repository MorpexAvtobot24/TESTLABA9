    {
      "name": "4. Create Order (Discount 5%)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"orderRef1\", \"REF1-\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nvar jsonData = pm.response.json();\r\n\r\npm.test(\"5% Discount applied correctly (Total = 57000)\", function () {\r\n    pm.expect(jsonData.status).to.eql(\"CONFIRMED\");\r\n    pm.expect(jsonData.total).to.eql(57000);\r\n});\r\n\r\nif (jsonData.id) {\r\n    pm.collectionVariables.set(\"orderId\", jsonData.id);\r\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"reference\": \"{{orderRef1}}\",\r\n  \"productId\": {{productId}},\r\n  \"quantity\": 4,\r\n  \"premium\": false,\r\n  \"couponValid\": false\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/orders",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "orders"
          ]
        }
      },
      "response": []
    },
